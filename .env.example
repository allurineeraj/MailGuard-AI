# ==============================================================================
# MailGuard AI Environment Configuration
# Copy this file to .env.local and populate with your Supabase credentials
# ==============================================================================

# Supabase Project URL (found under Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Public Key (Safe for browser client with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Application URL for Auth Redirects (http://localhost:3000 locally or https://your-project.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IMPORTANT SECURITY NOTE:
# Never add SUPABASE_SERVICE_ROLE_KEY to client bundles or commit it to Git.
# MailGuard AI performs all operations using Authenticated User RLS policies.
